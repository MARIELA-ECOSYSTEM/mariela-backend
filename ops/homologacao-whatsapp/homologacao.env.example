# Fase 22.8.9.10.7.7 — configuração do AMBIENTE LOCAL DE HOMOLOGAÇÃO do WhatsApp oficial.
#
# Este arquivo é só o MODELO (versionado, sem nenhum segredo). O `preparar.ps1` copia para
#   %LOCALAPPDATA%\MARIELA-HOMOLOGACAO\config\homologacao.env
# (fora de qualquer repositório, acesso só do seu usuário do Windows) e gera ali os segredos JWT locais.
# As credenciais da Meta são preenchidas À MÃO por você nessa cópia — nunca aqui, nunca no chat.
#
# O `iniciar.ps1` lê a cópia, roda o verificador de isolamento e só então sobe MongoDB, backend e Backoffice.
# Formato: CHAVE=valor (sem aspas, sem espaços em volta do "="). Linhas com # são comentários.

# ─── Identificação do ambiente (não altere) ─────────────────────────────────────────────────────────────────────────
MARIELA_AMBIENTE=homologacao-whatsapp
NODE_ENV=development
TZ=America/Sao_Paulo
PORT=3100
API_PREFIX=api/v1

# MongoDB DESCARTÁVEL local (porta 27217, replica set própria). Nunca Atlas, nunca marielaDB.
MONGODB_URI=mongodb://127.0.0.1:27217/mariela_homologacao_whatsapp?replicaSet=rs-homologacao-whatsapp

# Só o Backoffice local de homologação (porta 5180).
CORS_ORIGINS=http://localhost:5180

# Segredos LOCAIS desta homologação — gerados pelo preparar.ps1 (valores aleatórios, só deste computador).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
PDV_JWT_ACCESS_SECRET=
PDV_JWT_REFRESH_SECRET=

# ─── Desligados de propósito (o verificador recusa se forem preenchidos) ─────────────────────────────────────────────
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# ─── WhatsApp Cloud API — APLICATIVO DA META DE HOMOLOGAÇÃO (nunca o de produção) ──────────────────────────────────
# Enquanto estiver vazio ou "desativado", NADA é enviado (as rotas respondem WHATSAPP_NOT_CONFIGURED).
# Só troque para meta-cloud-api depois de preencher TODO o bloco abaixo.
WHATSAPP_PROVEDOR_ENVIO=desativado

# Número do remetente de homologação (o número de teste da Meta), em E.164. Não é segredo.
WHATSAPP_OWNER_PHONE=

META_WHATSAPP_GRAPH_API_VERSION=
# IDs do app de HOMOLOGAÇÃO (painel da Meta → WhatsApp → Configuração da API). Não são segredos.
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
# CREDENCIAIS (preencha só aqui, nesta cópia local):
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_APP_SECRET=
# Texto aleatório escolhido por você, igual ao cadastrado no webhook do app de homologação.
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_WHATSAPP_TIMEOUT_MS=

# ─── Travas da homologação (lidas só pelo verificador de isolamento, nunca pelo backend) ───────────────────────────
# Confirmação explícita: as credenciais acima são do app de HOMOLOGAÇÃO. Só "sim" é aceito.
HOMOLOGACAO_CONFIRMO_APP_DA_META_SEPARADO=
# De 1 a 5 números AUTORIZADOS (E.164, separados por vírgula) — os mesmos cadastrados como destinatários de teste no
# app da Meta. Todo cliente do banco de homologação precisa ter um desses números, senão nada sobe.
HOMOLOGACAO_DESTINOS_PERMITIDOS=
# Phone Number ID (e, se quiser, o WABA ID) da PRODUÇÃO — identificadores, não segredos. O verificador recusa
# subir se o app de homologação estiver usando o mesmo número.
HOMOLOGACAO_PHONE_NUMBER_ID_PRODUCAO=
HOMOLOGACAO_WABA_ID_PRODUCAO=
