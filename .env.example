# Ambiente da aplicação: development | test | production
NODE_ENV=development

# Timezone do processo do servidor. Se ausente, o backend fixa
# "America/Sao_Paulo" automaticamente (ver src/main.ts) — declarar aqui é
# redundante mas recomendado para deixar explícito no ambiente/orquestrador
# (Docker/systemd), especialmente se a loja física algum dia mudar de fuso.
TZ=America/Sao_Paulo

# Porta HTTP da API.
PORT=3000

# Prefixo global das rotas de negócio (não se aplica a /health e /docs).
API_PREFIX=api/v1

# String de conexão do MongoDB (Mongoose). Em desenvolvimento local (sem
# autenticação), o valor abaixo já basta. Em produção via docker-compose.yml,
# esta variável é SOBRESCRITA automaticamente pelo serviço `api` (interpola
# MARIELA_APP_MONGO_USER/PASSWORD abaixo) — não precisa ser preenchida à mão
# nesse cenário, só precisa existir (o .env é compartilhado pelos dois usos).
#
# O NOME DO BANCO vem sempre do path da URI (obrigatório desde a Fase 48.1-B)
# e muda por ambiente, de propósito (Fase 58 — nada no código depende dele):
#   - `mariela`: stack local/self-hosted do docker-compose.yml (o usuário de
#     aplicação criado por docker/mongo-init só tem readWrite nele);
#   - `marielaDB`: produção no MongoDB Atlas (Render) — o mesmo banco usado pelo
#     backup (docs/backup-mongodb.md, ops/backup/*.ps1);
#   - `mariela_test`: testes automatizados e CI.
# Atenção: a API não tem como saber se um banco EXISTENTE é o certo — confira o
# nome no path ao configurar cada ambiente (ex.: nunca `.../mariela` no Atlas).
MONGODB_URI=mongodb://localhost:27017/mariela

# ---------------------------------------------------------------------------
# Autenticação do MongoDB (Etapa 28) — só usada pelo docker-compose.yml
# (serviço `mongodb` + script ./docker/mongo-init). Nunca lidas pelo processo
# da API diretamente. Dois usuários distintos, propositalmente:
#   - ROOT (MONGO_INITDB_ROOT_*): administrativo (backup, criação de outros
#     usuários) — banco `admin`, papel `root`. NUNCA usado pela aplicação.
#   - APP (MARIELA_APP_MONGO_*): usado pela API — escopado SÓ ao banco
#     `mariela`, papel `readWrite`, nada além disso.
# Um vazamento do usuário de aplicação nunca dá acesso administrativo ao
# banco; um vazamento do root nunca é o que a API usa no dia a dia.
#
# Só têm efeito na PRIMEIRA inicialização do container `mongodb` (volume
# `mongodb_data` vazio) — a imagem oficial cria o root e o script de init cria
# o usuário de aplicação só nesse momento, nunca de novo depois.
#
# Evite caracteres especiais de URI (@ : / # % ?) nas senhas — elas entram
# direto numa connection string (`MONGODB_URI` do serviço `api`); se for
# realmente necessário usar algum desses caracteres, faça o URL-encode
# manualmente antes de colocar no .env.
# ---------------------------------------------------------------------------
MONGO_INITDB_ROOT_USERNAME=troque-por-um-usuario-root-forte
MONGO_INITDB_ROOT_PASSWORD=troque-por-uma-senha-root-forte-e-aleatoria
MARIELA_APP_MONGO_USER=troque-por-um-usuario-de-aplicacao
MARIELA_APP_MONGO_PASSWORD=troque-por-uma-senha-de-aplicacao-forte-e-aleatoria

# Segredos de assinatura dos tokens JWT — gere valores fortes e distintos por ambiente.
# NUNCA reutilize o mesmo segredo para access e refresh, e nunca use os valores de exemplo abaixo.
# JWT_ACCESS_SECRET assina o access token (JWT de verdade).
# JWT_REFRESH_SECRET NÃO assina um JWT — o refresh token é opaco/aleatório;
# este valor é a chave HMAC usada para hashear o refresh token antes de
# gravá-lo no MongoDB (nunca gravamos o token em texto puro).
JWT_ACCESS_SECRET=troque-este-valor-por-um-segredo-forte-e-aleatorio
JWT_REFRESH_SECRET=troque-este-valor-por-outro-segredo-forte-e-aleatorio
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Segredos do MARIELA PDV (autenticação de Vendedor) — DISTINTOS dos do
# Backoffice acima. Vendedor não é Usuario: um vazamento de um segredo nunca
# deve comprometer o outro domínio de identidade.
PDV_JWT_ACCESS_SECRET=troque-este-valor-por-um-segredo-forte-e-aleatorio-do-pdv
PDV_JWT_REFRESH_SECRET=troque-este-valor-por-outro-segredo-forte-e-aleatorio-do-pdv
PDV_JWT_ACCESS_EXPIRES_IN=30m
PDV_JWT_REFRESH_EXPIRES_IN=12h

# Origens permitidas por CORS (Fase 58), separadas por vírgula — lista EXATA:
# `http(s)://host[:porta]` sem caminho/barra final, ou `tauri://localhost`.
# Curinga (*) é sempre recusado (a API não sobe). Vazio = CORS desligado
# (nenhum frontend em outra origem consegue chamar a API).
# Origens verificadas dos frontends:
#   - Backoffice em desenvolvimento: http://localhost:8081 (tauri.conf.json devUrl / Vite port)
#   - PDV em desenvolvimento:        http://localhost:8080 (tauri.conf.json devUrl)
#   - Backoffice e PDV EMPACOTADOS (Tauri 2): http://tauri.localhost no Windows,
#     tauri://localhost no macOS/Linux (mesma origem para os dois apps).
# Produção (Render): http://tauri.localhost (e tauri://localhost se houver
# instalação em macOS/Linux) — sem as origens de desenvolvimento.
CORS_ORIGINS=http://localhost:8081,http://localhost:8080

# Referência dos nomes usados por `bun run seed:admin` (script local, não são
# lidos pelo servidor). Desde a Fase 60.4.3.2.1 o seed NÃO lê este arquivo
# (`--no-env-file`): defina-as só no processo, junto com ADMIN_SEED_CONFIRM.
# Nunca commitar valores reais.
ADMIN_EMAIL=admin@mariela.com
ADMIN_NAME=Administradora
ADMIN_PASSWORD=troque-por-uma-senha-forte

# Expõe /docs e /docs-json quando NODE_ENV=production (fora de produção, o
# Swagger já fica sempre habilitado, independente desta variável). Deixe
# ausente/false a menos que haja uma necessidade real de consultar o schema
# da API em produção.
SWAGGER_ENABLED=false

# ---------------------------------------------------------------------------
# WhatsApp (Etapa Pré-22) — integração via Evolution API + Baileys.
# Tudo opcional: se EVOLUTION_API_URL/EVOLUTION_API_KEY ficarem vazios, a
# integração fica desabilitada (GET /integracoes/whatsapp/status responde
# NOT_CONFIGURED) e o resto da API funciona normalmente.
# Necessárias em: qualquer ambiente que vá ENVIAR mensagens (homologação com
# número de teste, produção). Desenvolvimento sem WhatsApp: deixe vazias.
# ---------------------------------------------------------------------------

# Número oficial da loja (WhatsApp remetente/owner da instância) — configuração
# de infraestrutura da instância Evolution, não um segredo. Formato E.164.
WHATSAPP_OWNER_PHONE=+55XXXXXXXXXXX

# URL base da Evolution API (serviço externo — ver docker-compose.yml).
# Atenção (Fase 58): o docker-compose.yml publica a Evolution API na porta 8081
# do host — a MESMA porta do dev server do Backoffice (Vite, strictPort). Não
# rode os dois ao mesmo tempo na mesma máquina sem trocar uma das portas.
EVOLUTION_API_URL=http://localhost:8081

# Chave global da Evolution API (AUTHENTICATION_API_KEY do serviço Evolution).
# NUNCA commitar o valor real — apenas o placeholder vazio abaixo.
EVOLUTION_API_KEY=

# Nome da instância Baileys dedicada ao WhatsApp da loja.
EVOLUTION_INSTANCE_NAME=mariela-whatsapp

# Timeout (ms) para qualquer chamada HTTP do backend à Evolution API.
EVOLUTION_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Mídia — Cloudflare R2: imagens/vídeos do catálogo, enviados pelo Backoffice
# direto ao bucket via URL pré-assinada (ver README, seção "Mídia").
#   - Galeria (fluxo atual): POST /produtos/:id/midias/uploads → PUT na URL
#     assinada → POST .../uploads/:uploadId/confirmacao. O PUT precisa enviar
#     Content-Type e Cache-Control exatamente como devolvidos (ambos assinados,
#     assim como o Content-Length); a URL vale 10 minutos.
#   - Legado (Fase 40, a descontinuar): POST /media/presigned-upload — não
#     registra o upload em uploads_midia.
# Tudo opcional para o boot: se qualquer uma das 5 variáveis R2_* faltar, os
# endpoints de upload respondem 503 STORAGE_NOT_CONFIGURED (a API sobe
# normalmente). NUNCA commitar valores reais; o Secret nunca é logado nem
# devolvido por nenhuma resposta.
# Necessárias em: qualquer ambiente com upload de mídia (bucket de teste
# próprio, produção). Desenvolvimento sem mídia: deixe vazias.
# Conferência local, sem rede e sem exibir valores: bun run midias:verificar-r2
#
# Configuração EXTERNA (no Cloudflare, não aqui; não verificada pelo código):
#   - CORS do BUCKET: o PUT vai direto ao R2, então o bucket precisa liberar
#     o método PUT com os cabeçalhos content-type E cache-control para as
#     MESMAS origens do CORS_ORIGINS acima — inclusive http://tauri.localhost
#     (Tauri empacotado no Windows) e tauri://localhost (macOS/Linux, se houver).
#     Sem cache-control, o upload da galeria falha no preflight.
#   - Leitura pública do bucket pelo domínio de R2_PUBLIC_BASE_URL.
#   - Bucket separado para testes; nunca testar no bucket de produção.
# ---------------------------------------------------------------------------

# ID da conta Cloudflare (dashboard → R2). Compõe o endpoint S3
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com (região "auto").
R2_ACCOUNT_ID=

# Credenciais de um API Token do R2 com permissão de leitura e escrita de
# objetos, restrita a ESTE bucket (o backend assina PutObject e executa
# HeadObject, GetObject e DeleteObject — este só no comando local de limpeza).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Nome do bucket (o backend controla o prefixo das chaves: products/{produtoId}/).
R2_BUCKET_NAME=

# Base pública de leitura do bucket (domínio próprio ou o endereço público do
# R2), SEM barra final e sem query string, apontando para a RAIZ do bucket: a
# URL de cada objeto é <R2_PUBLIC_BASE_URL>/<chave>. Ex.: https://midia.exemplo.com
R2_PUBLIC_BASE_URL=

# Transporte das chamadas ao R2 (HeadObject, GetObject com Range, DeleteObject).
# Opcionais — vazias, valem os padrões do projeto (decisões operacionais deste
# backend, não recomendações da Cloudflare). O backend aplica o prazo de cada
# tentativa (conexão + resposta) e repete SÓ falhas transitórias (5xx, 429,
# rede, prazo esgotado); erros permanentes (403, 404, 400...) falham na hora.
# Faixas aceitas (fora delas, a API não sobe):
#   R2_CONNECTION_TIMEOUT_MS  100–60000   (padrão 3000)
#   R2_REQUEST_TIMEOUT_MS     100–120000  (padrão 10000)
#   R2_MAX_ATTEMPTS           1–5         (padrão 2 = uma nova tentativa)
R2_CONNECTION_TIMEOUT_MS=
R2_REQUEST_TIMEOUT_MS=
R2_MAX_ATTEMPTS=

# ---------------------------------------------------------------------------
# Rate limiting (Etapa 24) — piso GLOBAL/moderado aplicado a TODA rota
# (via @nestjs/throttler, guard global). Proteções específicas de login
# (/auth/login, /pdv/auth/login) e de envio de WhatsApp são mais restritivas
# e não são configuráveis por ambiente (ver auth.constants.ts,
# pdv-auth.constants.ts, whatsapp.constants.ts) — são valores de segurança
# calibrados deliberadamente, não parâmetros operacionais.
# ---------------------------------------------------------------------------

# Máximo de requisições por IP dentro da janela abaixo, em QUALQUER rota.
RATE_LIMIT_GLOBAL_LIMIT=300

# Janela (ms) do limite global acima. 300 req / 60000 ms = 5 req/s sustentado
# por IP — generoso o bastante para dashboard/CRUDs/sincronização do PDV, só
# como barreira contra abuso/DoS grosseiro.
RATE_LIMIT_GLOBAL_TTL_MS=60000

# ---------------------------------------------------------------------------
# Reconciliação automática de estoque em cancelamentos (Fase 60.4.3.4.18)
# ---------------------------------------------------------------------------
# Worker interno que conclui devoluções de estoque que falharam no momento do
# cancelamento (ver docs/reconciliacao-estoque-cancelamentos.md). Todas
# opcionais; vazio = padrão.
#   RECONCILIACAO_ESTOQUE_HABILITADA          true/false (padrão: ligado fora de NODE_ENV=test)
#   RECONCILIACAO_ESTOQUE_INTERVALO_MS        5000–86400000   (padrão 60000)
#   RECONCILIACAO_ESTOQUE_LOTE                1–500           (padrão 20 vendas por ciclo)
#   RECONCILIACAO_ESTOQUE_MAX_ITENS_POR_CICLO 1–5000          (padrão 50 linhas por ciclo)
#   RECONCILIACAO_ESTOQUE_MAX_TENTATIVAS      1–100           (padrão 8; depois disso: requer_intervencao)
#   RECONCILIACAO_ESTOQUE_BACKOFF_BASE_MS     1000–86400000   (padrão 30000; dobra a cada falha)
#   RECONCILIACAO_ESTOQUE_BACKOFF_MAX_MS      1000–604800000  (padrão 3600000)
RECONCILIACAO_ESTOQUE_HABILITADA=
RECONCILIACAO_ESTOQUE_INTERVALO_MS=
RECONCILIACAO_ESTOQUE_LOTE=
RECONCILIACAO_ESTOQUE_MAX_ITENS_POR_CICLO=
RECONCILIACAO_ESTOQUE_MAX_TENTATIVAS=
RECONCILIACAO_ESTOQUE_BACKOFF_BASE_MS=
RECONCILIACAO_ESTOQUE_BACKOFF_MAX_MS=
